{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-person-lab.dev/contracts/opl-skill-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "repository",
    "classification_policy",
    "skills"
  ],
  "properties": {
    "$schema": { "const": "./skill-catalog.schema.json" },
    "schema": { "const": "opl_skill_catalog.v2" },
    "repository": { "const": "gaofeng21cn/opl-skills" },
    "classification_policy": { "const": "metadata_only_never_implies_installation" },
    "skills": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/skill"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "categories"],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^skills/[a-z0-9][a-z0-9-]*$"
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "academic-delivery",
              "delivery-evidence",
              "external-learning",
              "local-application-adapter"
            ]
          }
        }
      }
    }
  }
}
